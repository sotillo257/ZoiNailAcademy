# Variables de entorno de la API (Railway). Copia a .env para local; nunca subas valores reales.
# Formato de .NET: "__" separa secciones (Jwt__SigningKey == Jwt:SigningKey).

ASPNETCORE_ENVIRONMENT=Production
PORT=8080
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT (SigningKey es secreto: mínimo 32 caracteres aleatorios)
Jwt__SigningKey=
Jwt__Issuer=ZoiNailAcademy.Api
Jwt__Audience=ZoiNailAcademy.Client
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# Cookie del refresh token (false solo en local por http)
Auth__CookieSecure=true

# Usuarios sembrados al arrancar (obligatorios en Production; contraseñas de 10+ caracteres)
Admin__SeedEmail=
Admin__SeedPassword=
Admin__SeedNombre=
SuperAdmin__SeedEmail=
SuperAdmin__SeedPassword=
SuperAdmin__SeedNombre=
# true resetea la contraseña del Admin a Admin__SeedPassword en el arranque; volver a false después
SuperAdmin__ResetAdminPassword=false

# Zona horaria en la que se muestran las fechas (la API guarda y devuelve UTC)
App__TimeZone=Europe/Madrid

# Reservas: se cierran X horas antes del inicio; "últimas plazas" si quedan <= umbral
Reservas__CierreHorasAntes=24
Reservas__UmbralUltimasPlazas=3

# Rate limiting por IP (Window en formato hh:mm:ss)
RateLimit__Auth__PermitLimit=10
RateLimit__Auth__Window=00:05:00
RateLimit__Reservas__PermitLimit=10
RateLimit__Reservas__Window=00:10:00
RateLimit__Formularios__PermitLimit=5
RateLimit__Formularios__Window=00:10:00

# IP real tras el edge de Railway y el rewrite de Next (ver /api/_diag/ip)
ForwardedHeaders__ForwardLimit=2
# ForwardedHeaders__KnownNetworks__0=fd12::/16
Diag__Enabled=false

# Swagger temporal en producción
Swagger__EnableInProduction=false
