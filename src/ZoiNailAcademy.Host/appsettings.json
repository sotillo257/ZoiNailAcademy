{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SigningKey": "",
    "Issuer": "ZoiNailAcademy.Api",
    "Audience": "ZoiNailAcademy.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Auth": {
    "CookieSecure": true
  },
  "Admin": {
    "SeedEmail": "",
    "SeedPassword": "",
    "SeedNombre": ""
  },
  "SuperAdmin": {
    "SeedEmail": "",
    "SeedPassword": "",
    "SeedNombre": "",
    "ResetAdminPassword": false
  },
  "RateLimit": {
    "Auth": { "PermitLimit": 10, "Window": "00:05:00" },
    "Reservas": { "PermitLimit": 10, "Window": "00:10:00" },
    "Formularios": { "PermitLimit": 5, "Window": "00:10:00" }
  },
  "ForwardedHeaders": {
    "ForwardLimit": 2,
    "KnownNetworks": []
  },
  "Diag": {
    "Enabled": false
  },
  "Swagger": {
    "EnableInProduction": false
  }
}
