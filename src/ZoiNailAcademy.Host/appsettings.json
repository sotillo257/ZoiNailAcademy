{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SigningKey": "",
    "Issuer": "ZoiNailAcademy.Api",
    "Audience": "ZoiNailAcademy.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Auth": {
    "CookieSecure": true
  },
  "Admin": {
    "SeedEmail": "",
    "SeedPassword": "",
    "SeedNombre": ""
  },
  "SuperAdmin": {
    "SeedEmail": "",
    "SeedPassword": "",
    "SeedNombre": "",
    "ResetAdminPassword": false
  },
  "App": {
    "BaseUrl": "",
    "TimeZone": "Europe/Madrid",
    "NombreAcademia": "Zoi Nail Academy",
    "DireccionAcademia": ""
  },
  "Email": {
    "Provider": "Resend",
    "From": "",
    "ReplyTo": "",
    "AvisosClienta": "",
    "AcuseContacto": false,
    "DirectorioLog": ""
  },
  "Resend": {
    "ApiKey": ""
  },
  "Reservas": {
    "CierreHorasAntes": 24,
    "UmbralUltimasPlazas": 3,
    "StripeMinutosBloqueo": 30,
    "MaxPendientesPorContacto": 2,
    "ManualHorasCaducidad": 48,
    "JobIntervaloMinutos": 5
  },
  "Pago": {
    "Titular": "",
    "Iban": "",
    "BizumTelefono": "",
    "WhatsAppTelefono": ""
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "RateLimit": {
    "Auth": { "PermitLimit": 10, "Window": "00:05:00" },
    "Reservas": { "PermitLimit": 10, "Window": "00:10:00" },
    "Formularios": { "PermitLimit": 5, "Window": "00:10:00" }
  },
  "ForwardedHeaders": {
    "ForwardLimit": 2,
    "KnownNetworks": []
  },
  "Diag": {
    "Enabled": false
  },
  "Swagger": {
    "EnableInProduction": false
  }
}
